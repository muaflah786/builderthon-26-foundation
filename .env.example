# Copy to .env.local for local development:  cp .env.example .env.local
# Every variable is validated in src/lib/env.ts — add new ones there AND here.

# ---- Database (libSQL / SQLite) ----
# Local: a SQLite file in the project root (created automatically).
DATABASE_URL=file:./local.db
# Production (Turso): DATABASE_URL=libsql://<db-name>-<org>.turso.io
# DATABASE_AUTH_TOKEN=

# ---- Auth ----
# REQUIRED in production, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-in-production
# Sign-in/sign-up rate limiting: on | off (off ONLY for automated E2E runs)
AUTH_RATE_LIMIT=on
# Public base URL of the app (no trailing slash)
APP_URL=http://localhost:3000

# ---- Logging ----
# debug | info | warn | error
LOG_LEVEL=info

# ---- Optional: file uploads (leave STORAGE_DRIVER unset to disable /api/uploads) ----
# local = ./uploads folder (development only) · s3 = S3-compatible bucket (AWS S3, Cloudflare R2, ...)
# STORAGE_DRIVER=local
# UPLOAD_MAX_BYTES=5242880
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-<id>.r2.dev

# ---- Optional: AI website assistant (docs/T6_PROVIDER_GUIDE.md) ----
# Leave AI_PROVIDER unset to disable the assistant. Exactly one provider is used; there is no automatic fallback.
# Local + free:  install Ollama, run: ollama pull qwen2.5:3b  (serves ONLY this computer, not a public site)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b
# Hosted (for a public deployment): OpenRouter free models (id ends with ":free") or Gemini free tier.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=<a model id ending in :free>
# OPENROUTER_ALLOW_PAID_MODELS=false
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_TIMEOUT_MS=90000
# AI_MAX_OUTPUT_TOKENS=512
# ASSISTANT_RATE_LIMIT_PER_MINUTE=15
# ASSISTANT_ALLOWED_ORIGINS=https://other-site.example

# ---- Public (exposed to the browser — never put secrets here) ----
NEXT_PUBLIC_APP_NAME=ORDOX
